{
  "name": "cardforge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && pnpm --filter @cardforge/web build",
    "clean": "tsc -b --clean",
    "dev": "pnpm --filter @cardforge/web dev",
    "dev:server": "pnpm --filter @cardforge/match-server dev",
    "dev:sim": "tsc -b && node apps/simulator/dist/cli.js",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "sim": "pnpm build && node apps/simulator/dist/cli.js",
    "smoke:web": "pnpm --filter @cardforge/web smoke",
    "smoke:server": "pnpm --filter @cardforge/match-server smoke",
    "smoke:storage": "pnpm --filter @cardforge/match-server smoke:storage",
    "smoke:selected-decks": "pnpm --filter @cardforge/match-server smoke:selected-decks",
    "smoke:online": "pnpm --filter @cardforge/web smoke:online",
    "test": "pnpm build && node --test apps/simulator/dist/*.test.js apps/match-server/dist/*.test.js packages/persistence/dist/*.test.js",
    "smoke:persistence": "pnpm --filter @cardforge/persistence smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "fast-check": "^4.9.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
