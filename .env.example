# --- Local development (pnpm dev / pnpm dev:server) ---------------------------
# Omit DATABASE_URL to use the in-memory store (data is lost on restart).
DATABASE_URL=postgres://postgres:cardforge_dev@127.0.0.1:54329/cardforge
CARDFORGE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CARDFORGE_WEB_URL=http://localhost:3000
CARDFORGE_PUBLIC_URL=http://localhost:2567
# Web client: where the browser reaches the match server (read at request time).
CARDFORGE_PUBLIC_API_URL=http://localhost:2567
CARDFORGE_ACTION_CLOCK_MS=30000
# Optional locally; required (>= 32 chars) in production.
# CARDFORGE_SESSION_SECRET=
# Discord user IDs granted the admin role at Discord sign-in. Email accounts
# are promoted with POST /api/admin/accounts/:accountId/role (see docs/auth.md).
# CARDFORGE_ADMIN_DISCORD_IDS=
# Operator token for automation and /metrics (>= 32 chars).
# CARDFORGE_ADMIN_TOKEN=
# Discord OAuth (redirect URI: $CARDFORGE_PUBLIC_URL/api/auth/discord/callback)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
