# Copy to .env.production (or paste into Coolify's environment editor).
# Generate secrets with: openssl rand -hex 32

# production or staging
CARDFORGE_ENVIRONMENT=production
CARDFORGE_WEB_URL=https://play.example.com
CARDFORGE_PUBLIC_API_URL=https://api.example.com

POSTGRES_DB=cardforge
POSTGRES_USER=cardforge
POSTGRES_PASSWORD=change-me-long-random

CARDFORGE_SESSION_SECRET=change-me-at-least-32-characters-random
CARDFORGE_ADMIN_TOKEN=change-me-at-least-32-characters-random

# Closed alpha: only people with a code can register.
CARDFORGE_SIGNUP_MODE=invite
CARDFORGE_SIGNUP_CODES=alpha-wave-1

# Optional Discord login.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

CARDFORGE_ACTION_CLOCK_MS=45000
CARDFORGE_RECONNECT_SECONDS=60
CARDFORGE_LOG_LEVEL=info
