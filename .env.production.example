# For Docker hosts other than Coolify. (On Coolify, the SERVICE_* values are
# generated for you; only CARDFORGE_SIGNUP_CODES needs entering.)
# Copy to .env.production. Generate secrets with: openssl rand -hex 32

# Public origins. Use two hostnames on one domain you own.
SERVICE_URL_WEB=https://play.example.com
SERVICE_URL_MATCH_SERVER=https://api.example.com

SERVICE_USER_POSTGRES=cardforge
SERVICE_PASSWORD_POSTGRES=change-me-long-random
SERVICE_HEX_64_SESSION=change-me-64-hex-characters
SERVICE_HEX_64_OPERATOR=change-me-64-hex-characters

# Closed alpha: only people with one of these codes can register.
CARDFORGE_SIGNUP_CODES=alpha-wave-1

# Optional.
# CARDFORGE_ENVIRONMENT=staging
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# CARDFORGE_ADMIN_DISCORD_IDS=
